<?xml version="1.0" encoding="utf-8"?>
<!-- Uma etapa da linha do tempo: bolinha + traço à esquerda, texto à direita -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="match_parent">

        <View
            android:id="@+id/traco_etapa"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="26dp"
            android:background="@color/cor_linha" />

        <ImageView
            android:id="@+id/ponto_etapa"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/ponto_pendente"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ic_check"
            app:tint="@color/cor_sobre_primaria" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/titulo_etapa"
            style="@style/Texto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/data_etapa"
            style="@style/Texto.Apagado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
