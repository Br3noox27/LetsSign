<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_toolbar" />

    <include layout="@layout/include_passos" />

    <TextView
        style="@style/Texto.Apagado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/instrucao_posicionar" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupo_signatarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <include
        android:id="@+id/visualizador"
        layout="@layout/include_visualizador_pdf"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout style="@style/LetsSign.BarraInferior"
        android:orientation="vertical">

        <TextView
            android:id="@+id/texto_resumo_campos"
            style="@style/Texto.Apagado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_adicionar_campo"
                style="@style/Widget.LetsSign.Botao.Perigo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/botao_adicionar_campo"
                app:icon="@drawable/ic_adicionar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_excluir_campo"
                style="@style/Widget.LetsSign.Botao.Contorno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/botao_excluir_campo"
                app:icon="@drawable/ic_excluir" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_revisar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:text="@string/botao_revisar_envio" />
    </LinearLayout>
</LinearLayout>
