<?xml version="1.0" encoding="utf-8"?>
<!-- Passos do fluxo: 1 Dados, 2 Campos, 3 Revisão (o atual fica preto) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/passos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/passo_1"
        style="@style/Texto.Passo"
        android:layout_marginEnd="6dp"
        android:text="@string/passo_dados" />

    <TextView
        android:id="@+id/passo_2"
        style="@style/Texto.Passo"
        android:layout_marginEnd="6dp"
        android:text="@string/passo_campos" />

    <TextView
        android:id="@+id/passo_3"
        style="@style/Texto.Passo"
        android:text="@string/passo_revisao" />
</LinearLayout>
