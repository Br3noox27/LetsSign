<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vazio: ícone, texto curto e um botão claro -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz_vazio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/icone_vazio"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/fundo_vazio"
        android:importantForAccessibility="no"
        android:padding="24dp"
        android:src="@drawable/ic_documento"
        app:tint="?attr/colorOnSecondaryContainer" />

    <TextView
        android:id="@+id/texto_vazio"
        style="@style/Texto.Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/detalhe_vazio"
        style="@style/Texto.Apagado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botao_vazio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:icon="@drawable/ic_adicionar"
        />
</LinearLayout>
