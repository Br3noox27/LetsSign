<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Preto e branco. Claro é o padrão; o escuro vem de values-night (cores) e do botão de tema. -->
    <style name="Theme.LetsSign.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cor_primaria</item>
        <item name="colorOnPrimary">@color/cor_sobre_primaria</item>
        <item name="colorPrimaryContainer">@color/cor_suave</item>
        <item name="colorOnPrimaryContainer">@color/cor_texto</item>
        <item name="colorSecondary">@color/cor_primaria</item>
        <item name="colorOnSecondary">@color/cor_sobre_primaria</item>
        <item name="colorSecondaryContainer">@color/cor_suave</item>
        <item name="colorOnSecondaryContainer">@color/cor_texto</item>
        <item name="colorTertiary">@color/cor_primaria</item>
        <item name="colorError">@color/cor_erro</item>
        <item name="colorOnError">@color/cor_sobre_primaria</item>
        <item name="colorErrorContainer">@color/cor_erro_suave</item>
        <item name="colorOnErrorContainer">@color/cor_erro</item>
        <item name="android:colorBackground">@color/cor_app</item>
        <item name="colorOnBackground">@color/cor_texto</item>
        <item name="colorSurface">@color/cor_superficie</item>
        <item name="colorOnSurface">@color/cor_texto</item>
        <item name="colorSurfaceVariant">@color/cor_suave</item>
        <item name="colorOnSurfaceVariant">@color/cor_secundario</item>
        <item name="colorOutline">@color/cor_linha</item>
        <item name="colorOutlineVariant">@color/cor_linha</item>
        <item name="colorSurfaceContainerLowest">@color/cor_superficie</item>
        <item name="colorSurfaceContainerLow">@color/cor_superficie</item>
        <item name="colorSurfaceContainer">@color/cor_superficie</item>
        <item name="colorSurfaceContainerHigh">@color/cor_superficie</item>
        <item name="colorSurfaceContainerHighest">@color/cor_suave</item>
        <item name="colorSurfaceInverse">@color/cor_texto</item>
        <item name="colorOnSurfaceInverse">@color/cor_superficie</item>
        <item name="colorPrimaryInverse">@color/cor_superficie</item>
        <item name="colorControlHighlight">#1F808080</item>

        <item name="android:statusBarColor">@color/cor_superficie</item>
        <item name="android:windowLightStatusBar">@bool/barra_clara</item>
        <item name="android:navigationBarColor">@color/cor_superficie</item>

        <!-- Fontes -->
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="fontFamily">@font/jakarta</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.LetsSign.DisplaySmall</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.LetsSign.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.LetsSign.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.LetsSign.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.LetsSign.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.LetsSign.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LetsSign.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.LetsSign.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.LetsSign.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.LetsSign.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.LetsSign.LabelSmall</item>

        <!-- Componentes -->
        <item name="toolbarStyle">@style/Widget.LetsSign.Toolbar</item>
        <item name="actionMenuTextAppearance">@style/TextAppearance.LetsSign.Menu</item>
        <item name="actionMenuTextColor">@color/cor_secundario</item>
        <item name="materialCardViewStyle">@style/Widget.LetsSign.Cartao</item>
        <item name="textInputStyle">@style/Widget.LetsSign.Campo</item>
        <item name="materialButtonStyle">@style/Widget.LetsSign.Botao</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.LetsSign.Botao.Contorno</item>
        <item name="bottomNavigationStyle">@style/Widget.LetsSign.MenuInferior</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.LetsSign.Progresso</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.LetsSign.Fab</item>
    </style>

    <style name="Theme.LetsSign" parent="Theme.LetsSign.Base" />

    <!-- Tipografia: Sora nos títulos, Plus Jakarta Sans no resto -->
    <style name="TextAppearance.LetsSign.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/sora</item>
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.LetsSign.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/sora</item>
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.LetsSign.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/sora</item>
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.LetsSign.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.LetsSign.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
    </style>
    <style name="TextAppearance.LetsSign.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
    </style>
    <style name="TextAppearance.LetsSign.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
    </style>
    <style name="TextAppearance.LetsSign.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
    </style>
    <style name="TextAppearance.LetsSign.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.LetsSign.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
    </style>
    <style name="TextAppearance.LetsSign.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
    </style>

    <!-- "Sair" na barra do topo: sem maiúsculas, discreto -->
    <style name="TextAppearance.LetsSign.Menu" parent="TextAppearance.LetsSign.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Barra do topo: branca, título em Sora -->
    <style name="Widget.LetsSign.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="titleTextAppearance">@style/TextAppearance.LetsSign.TitleLarge</item>
    </style>

    <style name="Widget.LetsSign.Cartao" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="strokeColor">@color/cor_linha</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/cor_superficie</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.LetsSign.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/cor_superficie</item>
        <item name="boxStrokeColor">@color/campo_contorno</item>
        <item name="hintTextColor">@color/cor_texto</item>
    </style>

    <!-- Botão principal: preto com texto branco (no escuro, o contrário) -->
    <style name="Widget.LetsSign.Botao" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/Forma.LetsSign.Botao</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.LetsSign.Botao.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/Forma.LetsSign.Botao</item>
        <item name="strokeColor">@color/cor_linha</item>
        <item name="android:textColor">@color/botao_contorno_texto</item>
        <item name="iconTint">@color/botao_contorno_texto</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.LetsSign.Botao.Perigo" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/Forma.LetsSign.Botao</item>
        <item name="strokeColor">@color/cor_erro</item>
        <item name="android:textColor">@color/botao_perigo_texto</item>
        <item name="iconTint">@color/botao_perigo_texto</item>
    </style>

    <style name="Forma.LetsSign.Botao" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Forma.LetsSign.Pilula" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Botão flutuante em pílula preta, como no protótipo -->
    <style name="Widget.LetsSign.Fab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">@color/cor_primaria</item>
        <item name="android:textColor">@color/cor_sobre_primaria</item>
        <item name="iconTint">@color/cor_sobre_primaria</item>
        <item name="shapeAppearanceOverlay">@style/Forma.LetsSign.Pilula</item>
    </style>

    <style name="Widget.LetsSign.MenuInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/fundo_menu_inferior</item>
        <item name="backgroundTint">@null</item>
        <item name="itemIconTint">@color/menu_inferior_item</item>
        <item name="itemTextColor">@color/menu_inferior_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LetsSign.MenuInferior.Indicador</item>
    </style>

    <style name="Widget.LetsSign.MenuInferior.Indicador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cor_suave</item>
    </style>

    <style name="Widget.LetsSign.Progresso" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/cor_primaria</item>
        <item name="trackColor">@color/cor_linha</item>
        <item name="trackCornerRadius">3dp</item>
        <item name="trackThickness">5dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <!-- Chip de filtro: contorno cinza; marcado = preenchido de preto -->
    <style name="Widget.LetsSign.ChipFiltro" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_filtro_fundo</item>
        <item name="android:textColor">@color/chip_filtro_texto</item>
        <item name="chipStrokeColor">@color/chip_filtro_contorno</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="shapeAppearance">@style/Forma.LetsSign.Pilula</item>
    </style>

    <!-- Chip de status: só contorno e texto na cor do status -->
    <style name="Widget.LetsSign.ChipStatus" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">26dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:textAppearance">@style/TextAppearance.LetsSign.ChipStatus</item>
        <item name="shapeAppearance">@style/Forma.LetsSign.Pilula</item>
        <item name="chipStartPadding">4dp</item>
        <item name="chipEndPadding">4dp</item>
    </style>

    <style name="TextAppearance.LetsSign.ChipStatus" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
    </style>

    <!-- Barra fixa de ação embaixo (branca, com linha em cima) -->
    <style name="LetsSign.BarraInferior" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fundo_rodape</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- Textos -->
    <style name="Texto.Hero" parent="TextAppearance.LetsSign.HeadlineSmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/cor_texto</item>
    </style>

    <style name="Texto.Manchete" parent="TextAppearance.LetsSign.HeadlineSmall">
        <item name="android:textColor">@color/cor_texto</item>
    </style>

    <style name="Texto.Titulo" parent="TextAppearance.LetsSign.TitleMedium">
        <item name="android:textColor">@color/cor_texto</item>
    </style>

    <!-- Rótulo de seção: maiúsculas, Sora, cinza (como .sec-t do protótipo) -->
    <style name="Texto.Secao" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/sora</item>
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/cor_secundario</item>
    </style>

    <style name="Texto.Apagado" parent="TextAppearance.LetsSign.BodyMedium">
        <item name="android:textColor">@color/cor_secundario</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Texto.Passo" parent="TextAppearance.LetsSign.LabelMedium">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/fundo_passo</item>
        <item name="android:textColor">@color/cor_secundario</item>
    </style>

    <style name="Texto.Corpo" parent="TextAppearance.LetsSign.BodyLarge">
        <item name="android:textColor">@color/cor_texto</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
