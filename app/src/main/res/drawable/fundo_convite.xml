<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão do convite com faixa preta à esquerda -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/campo_c0" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="12dp" android:topRightRadius="12dp" />
            <solid android:color="@color/cor_superficie" />
            <stroke android:width="1dp" android:color="@color/cor_linha" />
        </shape>
    </item>
</layer-list>
