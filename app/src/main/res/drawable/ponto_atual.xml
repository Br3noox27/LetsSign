<?xml version="1.0" encoding="utf-8"?>
<!-- Etapa em andamento: contorno preto com um anel suave em volta -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/cor_suave" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/cor_superficie" />
            <stroke android:width="2dp" android:color="@color/cor_primaria" />
        </shape>
    </item>
</layer-list>
